# Optional. PostgreSQL connection string (e.g. Neon). If unset, a local JSON file store (.data/) is used
# in development and the deployed app runs in read-only demo mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional. Set to "true" to allow the demo reset endpoint on a deployed (production) instance.
DEMO_RESET_ENABLED=false

# Optional. Reference FX rates (Frankfurter / ECB). No key required. Override only to self-host.
FX_API_BASE_URL=https://api.frankfurter.dev/v1
